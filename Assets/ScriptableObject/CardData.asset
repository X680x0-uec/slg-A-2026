    explain: "\u73FE\u5728\u4F4D\u7F6E\u304B\u3089\u9032\u884C\u65B9\u5411\u306B10\u30DE\u30B9\u5148\u307E\u3067\u306E\u30DE\u30B9\u60C5\u5831\u3092\u4E00\u6642\u7684\u306B\u8868\u793A\u3059\u308B"
