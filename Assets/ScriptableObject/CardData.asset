    MinusTurn: 0
    explain: "\u672C\u6765\u306E\u51FA\u76EE\u5408\u8A08\u5024\u306B\u8FFD\u52A0\u306715\u30DE\u30B9\u9032\u3080\u3002"
  - cardName: "\u3010\u30A4\u30AB\u30B5\u30DE3\u3011\u73FE\u5B9F\u62D2\u5426"
    isUsed: 0
    PulsTurn: 0
    MinusTurn: 0
    explain: "\u81EA\u5206\u304C\u6B62\u307E\u3063\u305F\u30DE\u30B9\u306E\u52B9\u679C\u3092\u3001\u597D\u304D\u306A\u30DE\u30B9\u52B9\u679C\u306B\u5F37\u5236\u5909\u66F4\u3067\u304D\u308B"
  - cardName: "\u3010\u30A4\u30AB\u30B5\u30DE4\u3011\u5168\u4F53\u59A8\u5BB3"
    isUsed: 0
    PulsTurn: 0
    MinusTurn: 0
    explain: "\u81EA\u5206\u4EE5\u5916\u306E\u30D7\u30EC\u30A4\u30E4\u30FC\u306E\u30B4\u30FC\u30EB\u307E\u3067\u306E\u30DE\u30B9\u6570\u309210\u30DE\u30B9\u4F38\u3070\u3059"
  - cardName: "\u3010\u30A4\u30AB\u30B5\u30DE5\u3011\u795E\u7D4C\u59A8\u5BB3"
    isUsed: 0
    PulsTurn: 0
    MinusTurn: 0
    explain: "\u4F7F\u7528\u3057\u305F\u6B21\u306E\u30E9\u30A6\u30F3\u30C9\u304B\u30892\u30E9\u30A6\u30F3\u30C9\u306E\u9593\u3001\u4ED6\u30D7\u30EC\u30A4\u30E4\u30FC\u306F\u795E\u7D4C\u59A8\u5BB3\u306E\u4EE3\u511F\u52B9\u679C\u4EE5\u5916\u306E\u3059\u3079\u3066\u306E\u4EE3\u511F\u52B9\u679C\u304C\u767A\u52D5\u3057\u305F\u72B6\u614B\u306B\u306A\u308B"
  - cardName: "\u3010\u30A4\u30AB\u30B5\u30DE6\u3011\u51FA\u76EE\u507D\u88C5"
    isUsed: 0
    PulsTurn: 0
    MinusTurn: 0
    explain: "\u6B21\u306E\u30E9\u30A6\u30F3\u30C9\u3068\u3001\u305D\u306E\u6B21\u306E\u30E9\u30A6\u30F3\u30C9\u306E\u9593\u3001\u81EA\u5206\u304C\u9032\u3093\u3060\u30DE\u30B9\u6570\u304C2\uFF5E12\u306E\u7BC4\u56F2\u306E\u5024\u3068\u3057\u3066\u8868\u793A\u3055\u308C\u308B"
