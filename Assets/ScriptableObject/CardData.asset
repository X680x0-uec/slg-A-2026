    MinusTurn: 0
    explain: "\u6B21\u306B\u8E0F\u3080\u30DE\u30B9\u306E\u52B9\u679C\u3092\u7121\u52B9\u306B\u3059\u308B"
  - cardName: "\u3010\u30A4\u30AB\u30B5\u30DE1\u3011\u51FA\u76EE\u6539\u7AC4"
    isUsed: 0
    PulsTurn: 0
    MinusTurn: 0
    explain: "\u672C\u6765\u306E\u51FA\u76EE\u5408\u8A08\u5024\u304B\u3089\u3001\xB110\u306E\u7BC4\u56F2\u3067\u597D\u304D\u306A\u5024\u306B\u5909\u66F4\u3067\u304D\u308B\u3002"
